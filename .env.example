# Jev Classify Lab — variables de entorno (copia este archivo a `.env` y complétalo).
# Las API keys viven solo en el backend; nunca llegan al navegador. No subas `.env` al repositorio.

# --- Carril GPT (OpenAI) ---
OPENAI_API_KEY=                    # API key de OpenAI
OPENAI_MODEL=gpt-4.1-mini          # modelo (por defecto: gpt-4.1-mini)
OPENAI_PRICE_INPUT_PER_MTOK=0.40   # USD por millón de tokens de entrada (por defecto: 0.40)
OPENAI_PRICE_OUTPUT_PER_MTOK=1.60  # USD por millón de tokens de salida (por defecto: 1.60)
# OPENAI_REASONING_EFFORT=         # solo modelos de razonamiento gpt-5*/o* (none | minimal | low | medium | high | xhigh | max)
# OPENAI_MAX_COMPLETION_TOKENS=    # tope de tokens de salida (por defecto: depende de la familia del modelo)
# OPENAI_BASE_URL=                 # endpoint compatible con OpenAI (por defecto: el oficial de OpenAI)

# --- Carril Jev (modelo System One vía OpenCode Zen) — https://opencode.ai/docs/zen ---
OPENCODE_API_KEY=                  # API key de OpenCode Zen
JEV_MODEL=jev-1.13-free            # modelo (por defecto: jev-1.13-free)
# JEV_PRICE_INPUT_PER_MTOK=0.042   # USD por millón de tokens de entrada (por defecto: 0.042)
# OPENCODE_BASE_URL=               # (por defecto: https://opencode.ai/zen)

# --- Reglas de equidad: se aplican IGUAL a ambos motores ---
# CLASSIFY_TIMEOUT_MS=             # timeout por intento HTTP, en ms (por defecto: 30000)
# CLASSIFY_MAX_RETRIES=            # reintentos tras un fallo transitorio (por defecto: 1); nunca se reintenta tras un timeout

# --- Servidor (PORT y HOST se leen al arrancar: cambiarlos requiere reiniciar el API; lo demás se recarga en caliente) ---
PORT=8788                          # puerto del API (el front en Vite usa 5174 y hace proxy de /api a HOST:PORT)
HOST=127.0.0.1                     # interfaz donde escucha el API (por defecto: 127.0.0.1 = solo este equipo). El API gasta TUS keys:
                                   # 0.0.0.0 o una IP de la red lo exponen a otros equipos; úsalo solo en una red de confianza
